# Copy to .env. Only the OpenAI key is required locally; the database defaults to the
# dev container from docker-compose.dev.yml (localhost:54329, user/password replybek).

OPENAI_API_KEY=
# Models (must be allowed on the OpenAI project).
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Production: set DATABASE_URL (or PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD) and PGSSL=true if needed.
# DATABASE_URL=
# PGSSL=false

PORT=3100
# The dashboard's address, for CORS and cookies.
APP_ORIGIN=http://localhost:5173
# Where uploaded files are kept.
UPLOAD_DIR=./data/uploads
# Run the background worker inside the API process (fine for one server).
WORKER_IN_PROCESS=true
# Encrypts integration secrets and customers' sign-in tokens. Required in production.
SECRET_KEY=
# This API's public address. Integrations send signed-in customers back to {PUBLIC_API_URL}/oauth/callback.
PUBLIC_API_URL=http://localhost:3100
