# Copy to .env. Only the OpenAI key is required locally; the database defaults to the
# dev container from docker-compose.dev.yml (localhost:54329, user/password replybek).

OPENAI_API_KEY=
# Models (must be allowed on the OpenAI project).
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Production: set DATABASE_URL (or PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD) and PGSSL=true if needed.
# DATABASE_URL=
# PGSSL=false

PORT=3100
# The dashboard's address, for CORS and cookies.
APP_ORIGIN=http://localhost:5173
# Where uploaded files are kept: an S3-compatible store when S3_BUCKET is set (MinIO from
# docker-compose.dev.yml locally; MinIO, Hetzner Object Storage or any S3 in production; the bucket
# is created on the first upload), otherwise UPLOAD_DIR on this machine.
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=replybek
S3_ACCESS_KEY=replybek
S3_SECRET_KEY=replybek-dev
# S3_REGION=us-east-1
UPLOAD_DIR=./data/uploads
# Run the background worker inside the API process (fine for one server).
WORKER_IN_PROCESS=true
# Encrypts integration secrets and customers' sign-in tokens. Required in production.
SECRET_KEY=
# This API's public address. Integrations send signed-in customers back to {PUBLIC_API_URL}/oauth/callback.
PUBLIC_API_URL=http://localhost:3100

# Billing through Polar. Leave POLAR_ACCESS_TOKEN empty to keep plan switching simulated (no payment).
# An organization access token with checkouts:write, subscriptions:write and customer_sessions:write.
POLAR_ACCESS_TOKEN=
# The webhook's signing secret. Point the webhook at {PUBLIC_API_URL}/billing/polar/webhook
# (format "Raw") with the subscription.* events.
POLAR_WEBHOOK_SECRET=
# The Polar product (a UUID, monthly recurring) behind each Replybek plan.
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_BUSINESS=
# Sandbox while testing: https://sandbox-api.polar.sh/v1
# POLAR_API_URL=https://api.polar.sh/v1

# Email (invitations, "a customer is waiting", password resets). Without SMTP_URL nothing is sent:
# emails are printed to the API log, and the invite dialog shows the link to share by hand.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Replybek <no-reply@replybek.uz>

# "Continue with Google". Create an OAuth client (Web application) in Google Cloud Console and add
# {APP_ORIGIN}/api/auth/google/callback as an authorized redirect URI (or set GOOGLE_REDIRECT_URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://app.replybek.uz/api/auth/google/callback
